<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!-- Card Background matching app theme -->
    <ImageView
        android:id="@+id/widget_list_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_calendar_bg"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <!-- Header: Upcoming Timeline / Next 5 events -->
        <LinearLayout
            android:id="@+id/widget_list_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_list_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Timeline"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FF1F1F1F"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_list_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next 5 events"
                    android:textSize="11sp"
                    android:textColor="#88707070"
                    android:singleLine="true" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_list_header_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_book_5"
                android:contentDescription="SubsTrack" />
        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/widget_list_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="16dp">

            <TextView
                android:id="@+id/widget_list_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All clear on the horizon!"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF222222" />

            <TextView
                android:id="@+id/widget_list_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="No pending scheduled subscription renewals or upcoming preorders."
                android:textSize="11sp"
                android:textColor="#88707070"
                android:gravity="center" />
        </LinearLayout>

        <!-- Events List Container (up to 5 items) -->
        <LinearLayout
            android:id="@+id/widget_list_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Item 1 -->
            <LinearLayout
                android:id="@+id/widget_item_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_timeline_card_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:id="@+id/widget_bar_1"
                    android:layout_width="3.5dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_vertical_bar"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/widget_category_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Subscription"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/widget_timeline_chip_bg"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="1dp"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/widget_status_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Upcoming"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/widget_timeline_chip_bg"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="1dp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_title_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1.5dp"
                        android:text="Book Title"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="#FF222222"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_subtitle_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bookstore Name"
                        android:textSize="10.5sp"
                        android:textColor="#88707070"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/widget_date_card_1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/widget_timeline_date_bg">

                    <TextView
                        android:id="@+id/widget_date_month_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="2.5dp"
                        android:gravity="center"
                        android:text="OCT"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_date_day_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="24"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FF222222" />

                    <TextView
                        android:id="@+id/widget_date_time_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="2dp"
                        android:gravity="center"
                        android:text="10:00"
                        android:textSize="7.5sp"
                        android:textColor="#88707070" />
                </FrameLayout>
            </LinearLayout>

