<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="5dp">



    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- Card Background with 20dp rounded corners and subtle border matching home screen preorder card -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_preorder_tile_bg"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <!-- Asymmetric Left Indicator Bar -->
            <ImageView
                android:layout_width="3.5dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="3dp"
                android:src="@drawable/widget_vertical_bar"
                android:scaleType="fitXY"
                android:tint="#FF2563EB"
                android:contentDescription="@null" />

            <!-- Cover / Bookstore Picture Box (Rounded 10dp) -->
            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="2dp"
                android:layout_gravity="center_vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_thumb_box_bg"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="O"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FF2563EB" />
            </FrameLayout>

            <!-- Middle Column: Title, Author, Bookstore, Status+Price -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Onyx Storm"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- Author -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="By Rebecca Yarros"
                    android:textSize="11sp"
                    android:textColor="#FFCCCCCC"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- Bookstore -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0.5dp"
                    android:text="Waterstones"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#FF60A5FA"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- Status Badge + Price Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Filled Status Pill -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/widget_status_pill_bg"
                            android:tint="#FF1E3A8A"
                            android:scaleType="fitXY"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="6dp"
                            android:paddingRight="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="3dp"
                                android:src="@drawable/ic_status_shopping_bag"
                                android:tint="#FFFFFFFF"
                                android:contentDescription="@null" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Preordered"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFFFF" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="•"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#88FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$32.00"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right Column: Date Card Box -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginVertical="2dp"
                android:layout_gravity="center_vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_date_box_bg"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OCT"
                        android:textSize="8.5sp"
                        android:textStyle="bold"
                        android:textColor="#FF60A5FA" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="19"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01:30"
                        android:textSize="8.5sp"
                        android:textStyle="bold"
                        android:textColor="#FF60A5FA" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- Right Slider Indicator Dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_vertical_bar"
            android:scaleType="fitXY"
            android:tint="#FF2563EB"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="4dp"
            android:layout_height="5dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/widget_vertical_bar"
            android:scaleType="fitXY"
            android:tint="#4B5563"
            android:contentDescription="@null" />
    </LinearLayout>

</LinearLayout>
