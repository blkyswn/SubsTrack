<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_calendar_bg"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Timeline"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF1F1F1F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next 5 events"
                    android:textSize="10.5sp"
                    android:textColor="#88707070" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_book_5"
                android:contentDescription="SubsTrack" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_timeline_card_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <ImageView
                android:layout_width="3.5dp"
                android:layout_height="match_parent"
                android:src="@drawable/widget_vertical_bar"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subscription"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_timeline_chip_bg"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:text="Fourth Wing (Special Ed.)"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#FF222222"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Illumicrate"
                    android:textSize="10.5sp"
                    android:textColor="#88707070"
                    android:singleLine="true" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_timeline_date_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2.5dp"
                    android:gravity="center"
                    android:text="OCT"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="24"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FF222222" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_timeline_card_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <ImageView
                android:layout_width="3.5dp"
                android:layout_height="match_parent"
                android:src="@drawable/widget_vertical_bar"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preorder"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_timeline_chip_bg"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:text="Iron Flame (Deluxe)"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#FF222222"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waterstones"
                    android:textSize="10.5sp"
                    android:textColor="#88707070"
                    android:singleLine="true" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_timeline_date_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2.5dp"
                    android:gravity="center"
                    android:text="OCT"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="28"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FF222222" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
